RELAY_PUBLIC_ORIGIN=https://relay.example.com
RELAY_PORT=4180
RELAY_IMAGE=ghcr.io/overnite22/relay-public:latest
RELAY_ALLOWED_USERS=admin@example.com
# Backup administrators can read every user's captures and authentication state.
RELAY_ADMIN_USERS=admin@example.com
OIDC_ISSUER_URL=https://login.microsoftonline.com/REPLACE_TENANT_ID/v2.0
OIDC_CLIENT_ID=REPLACE_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_RANDOM_COOKIE_SECRET
